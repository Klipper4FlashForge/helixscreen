#
# crosstool-NG defconfig for FlashForge Creator 5 Pro (MIPS32r2, NaN2008, musl, static)
#
# Target: mipsel-creator5-linux-musl
# CPU:    Ingenic X2000 (XBurst2) — MIPS32r2, little-endian, o32, hardware FP
#
# Why this exists: the Creator 5 Pro kernel refuses legacy-NaN executables with
# ENOEXEC ("Exec format error"). Every binary on the stock rootfs carries the
# EF_MIPS_NAN2008 flag (e.g. busybox: e_flags 0x70001405, interpreter
# /lib/ld-linux-mipsn8.so.1). Bootlin's mips32el musl toolchain (used for the
# Creality K1 target) emits legacy NaN and cannot be switched: its libc.a is
# legacy-NaN and ld refuses to mix NaN encodings. So GCC and musl are rebuilt
# here with NaN2008 as the *default*, which means OpenSSL, zlib, libnl and the
# wpa_supplicant client all inherit it with no per-project flag plumbing.
#
# FP mode is left at GCC's default for o32 (fpxx, "Any FPU"); the kernel runs
# that under either FR mode, and it avoids relying on musl under -mfp64.
#
# To use:
#   cp creator5-ct-ng.config .config
#   ct-ng olddefconfig
#   ct-ng build
#

CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y

#
# Install prefix
#
CT_PREFIX_DIR="/opt/creator5-toolchain"
# CT_PREFIX_DIR_RO is not set

#
# Target architecture
#
CT_ARCH_MIPS=y
CT_ARCH_LE=y
CT_ARCH_ARCH="mips32r2"
CT_ARCH_FLOAT_HW=y

#
# NaN2008 as the default for everything built by this compiler
#
CT_TARGET_CFLAGS="-mnan=2008"

#
# Static toolchain binaries (portable across Docker layers)
#
CT_STATIC_TOOLCHAIN=y

#
# Target tuple: mipsel-creator5-linux-musl
#
CT_TARGET_VENDOR="creator5"

#
# Linux kernel headers — stock kernel is the Ingenic 4.4 series
# (glibc on the device was built with --enable-kernel=3.10.14)
#
CT_KERNEL_LINUX=y
# 5.10 headers, not 4.9: on 32-bit musl 1.2 (64-bit time_t) the 4.9 linux/input.h
# makes struct input_event 24 bytes while the kernel emits 16 -> LVGL's evdev
# reader never sees a touch. Headers >= 4.20 keep the 16-byte layout.
CT_LINUX_V_5_10=y

#
# binutils 2.40
#
CT_BINUTILS_V_2_40=y

#
# musl libc
#
CT_LIBC_MUSL=y
CT_MUSL_V_1_2_4=y

#
# GCC 12 with NaN2008 baked in as the configure-time default
#
CT_GCC_V_12=y
CT_CC_GCC_EXTRA_CONFIG_ARRAY="--with-nan=2008"
CT_CC_LANG_CXX=y

#
# Skip debug tools (saves build time)
#
# CT_DEBUG_DUMA is not set
# CT_DEBUG_STRACE is not set
# CT_DEBUG_GDB is not set
