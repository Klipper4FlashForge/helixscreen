diff --git a/src/draw/lv_draw_buf.c b/src/draw/lv_draw_buf.c
--- a/src/draw/lv_draw_buf.c
+++ b/src/draw/lv_draw_buf.c
@@ -378,8 +378,8 @@
     if(buf == NULL) return NULL;
 
     if(x >= buf->header.w || y >= buf->header.h) {
-        LV_LOG_ERROR("coordinates out of range, x: %" LV_PRIu32 ", y: %"LV_PRIu32", w: %"LV_PRIu32", h: %"LV_PRIu32, x, y,
-                     (uint32_t)buf->header.w, (uint32_t)buf->header.h);
+        LV_LOG_WARN("coordinates out of range, x: %" LV_PRIu32 ", y: %"LV_PRIu32", w: %"LV_PRIu32", h: %"LV_PRIu32, x, y,
+                    (uint32_t)buf->header.w, (uint32_t)buf->header.h);
         return NULL;
     }
 
diff --git a/src/draw/sw/lv_draw_sw_mask_rect.c b/src/draw/sw/lv_draw_sw_mask_rect.c
--- a/src/draw/sw/lv_draw_sw_mask_rect.c
+++ b/src/draw/sw/lv_draw_sw_mask_rect.c
@@ -53,6 +53,13 @@
     lv_layer_t * target_layer = t->target_layer;
     lv_area_t * buf_area = &target_layer->buf_area;
     lv_area_t clear_area;
+
+    /*draw_area is clipped to dsc->area and the task clip area, but never to the
+     *layer's own buffer. An overhang on the left makes draw_area.x1 - buf_area->x1
+     *negative, which wraps in lv_draw_buf_goto_xy; an overhang on the right leaves
+     *the row pointer valid while area_w runs the writes past the end of the row.
+     *Clipping here keeps every row write in bounds. Upstream: lvgl/lvgl#9831*/
+    if(!lv_area_intersect(&draw_area, &draw_area, buf_area)) return;
 
     void * draw_buf = target_layer->draw_buf;
 
