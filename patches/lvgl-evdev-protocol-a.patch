+        if(touch_range_dbg < 0) {
+            touch_range_dbg = (getenv("HELIX_DEBUG_TOUCH") || getenv("HELIX_DEBUG_TOUCHES"))
+                              ? 1 : 0;
+        }
+        if(touch_range_dbg) {
