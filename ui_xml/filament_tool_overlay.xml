<?xml version="1.0"?>
<component>
  <api>
    <prop name="title" type="string" default="Filament"/>
  </api>
  <styles>
    <style name="extrude_length_btn_selected"
           bg_color="#primary" bg_opa="60" border_color="#primary" border_width="2" outline_width="1" outline_pad="-1"
           outline_color="#primary"/>
    <style name="extrude_length_btn_unselected" bg_color="#card_bg" bg_opa="0" border_color="#border" border_width="1"/>
  </styles>
  <view name="filament_tool_overlay" extends="overlay_panel" title="$title" bg_color="#screen_bg">
    <lv_obj name="overlay_content"
            width="100%" height="0" flex_grow="1" flex_flow="row" style_pad_all="#space_md" style_pad_gap="#space_sm"
            scrollable="false">
      <lv_obj name="tool_temperature_controls"
              width="55%" height="100%" flex_flow="column" style_pad_all="#space_sm" style_pad_gap="#space_sm"
              style_bg_color="#card_bg" style_bg_opa="0" style_border_width="0" style_border_color="#border"
              style_radius="0" scrollable="false">
        <lv_obj width="100%"
                height="content" flex_flow="row" style_pad_all="0" style_flex_cross_place="center" scrollable="false">
          <text_small text="Temperature" translation_tag="Temperature" style_text_font="#font_body_bold" flex_grow="1"/>
          <text_body name="tool_current_temperature"
                     bind_text="filament_nozzle_current" style_text_font="#font_body_bold"/>
        </lv_obj>
        <lv_obj width="100%"
                height="0" flex_grow="1" style_min_height="#button_height" flex_flow="row" style_pad_all="0"
                style_pad_gap="#space_sm" scrollable="false">
          <repeat count="2">
            <ui_button name="sheet_preset_${i}"
                       width="0" height="100%" flex_grow="1" variant="outline" layout="column"
                       style_pad_all="#space_xxs" style_border_color="#border">
              <event_cb trigger="clicked" callback="on_filament_temperature_sheet_action"/>
              <text_body bind_text="preset_material_${i}_name"/>
              <text_small bind_text="preset_material_${i}_nozzle_temp"/>
            </ui_button>
          </repeat>
        </lv_obj>
        <lv_obj width="100%"
                height="0" flex_grow="1" style_min_height="#button_height" flex_flow="row" style_pad_all="0"
                style_pad_gap="#space_sm" scrollable="false">
          <repeat count="2">
            <ui_button name="sheet_preset_${i + 2}"
                       width="0" height="100%" flex_grow="1" variant="outline" layout="column"
                       style_pad_all="#space_xxs" style_border_color="#border">
              <event_cb trigger="clicked" callback="on_filament_temperature_sheet_action"/>
              <text_body bind_text="preset_material_${i + 2}_name"/>
              <text_small bind_text="preset_material_${i + 2}_nozzle_temp"/>
            </ui_button>
          </repeat>
        </lv_obj>
        <lv_obj width="100%"
                height="#button_height_lg" flex_flow="row" style_pad_all="0" style_pad_gap="#space_sm"
                style_flex_cross_place="center" scrollable="false">
          <ui_button name="sheet_minus"
                     width="#button_height_lg" height="100%" text="-5" variant="outline" style_border_color="#border">
            <event_cb trigger="clicked" callback="on_filament_temperature_sheet_action"/>
          </ui_button>
          <text_body name="tool_temperature_draft"
                     width="0" bind_text="filament_sheet_value" style_text_font="#font_xl" style_text_align="center"
                     flex_grow="1"/>
          <ui_button name="sheet_plus"
                     width="#button_height_lg" height="100%" text="+5" translation_tag="+5" variant="outline"
                     style_border_color="#border">
            <event_cb trigger="clicked" callback="on_filament_temperature_sheet_action"/>
          </ui_button>
        </lv_obj>
        <lv_obj width="100%"
                height="#button_height_lg" flex_flow="row" style_pad_all="0" style_pad_gap="#space_sm"
                scrollable="false">
          <ui_button name="sheet_off"
                     width="0" height="100%" text="Off" translation_tag="Off" variant="outline" flex_grow="1"
                     style_border_color="#border">
            <event_cb trigger="clicked" callback="on_filament_temperature_sheet_action"/>
          </ui_button>
          <ui_button name="btn_primary"
                     width="0" height="100%" text="Heat" translation_tag="Heat" variant="primary" flex_grow="1"
                     style_bg_color="#success">
            <event_cb trigger="clicked" callback="on_filament_temperature_sheet_action"/>
          </ui_button>
        </lv_obj>
      </lv_obj>
      <lv_obj name="tool_controls_divider"
              width="1" height="100%" style_bg_color="#border" style_bg_opa="255" style_border_width="0"
              style_pad_all="0" scrollable="false" clickable="false"/>
      <lv_obj name="right_column"
              width="0" height="100%" flex_grow="1" style_pad_all="#space_sm" scrollable="false" flex_flow="column"
              style_flex_main_place="start" style_pad_gap="#space_sm" style_bg_color="#card_bg" style_bg_opa="0"
              style_border_width="0" style_border_color="#border" style_radius="0">
        <if cond="filament_has_tool eq 1">
          <text_small text="Move distance" translation_tag="Move distance" style_text_font="#font_body_bold"/>
          <lv_obj name="extrude_length_row"
                  width="100%" height="#button_height_lg" style_pad_all="0" scrollable="false" flex_flow="row"
                  style_flex_main_place="start" style_flex_cross_place="center" style_pad_gap="#space_sm">
            <ui_button name="extrude_length_5mm"
                       width="0" height="100%" flex_grow="1" text="5mm" style_text_font="#font_body_bold"
                       variant="outline">
              <bind_style name="extrude_length_btn_selected" subject="filament_extrude_length_5mm_active" ref_value="1"/>
              <bind_style name="extrude_length_btn_unselected"
                          subject="filament_extrude_length_5mm_active" ref_value="0"/>
              <bind_state_if cond="filament_operation_in_progress eq 1" state="disabled"/>
              <event_cb trigger="clicked" callback="on_filament_extrude_length_5mm"/>
            </ui_button>
            <ui_button name="extrude_length_10mm"
                       width="0" height="100%" flex_grow="1" text="10mm" style_text_font="#font_body_bold"
                       variant="outline">
              <bind_style name="extrude_length_btn_selected" subject="filament_extrude_length_10mm_active" ref_value="1"/>
              <bind_style name="extrude_length_btn_unselected"
                          subject="filament_extrude_length_10mm_active" ref_value="0"/>
              <bind_state_if cond="filament_operation_in_progress eq 1" state="disabled"/>
              <event_cb trigger="clicked" callback="on_filament_extrude_length_10mm"/>
            </ui_button>
            <ui_button name="extrude_length_25mm"
                       width="0" height="100%" flex_grow="1" text="25mm" style_text_font="#font_body_bold"
                       variant="outline">
              <bind_style name="extrude_length_btn_selected" subject="filament_extrude_length_25mm_active" ref_value="1"/>
              <bind_style name="extrude_length_btn_unselected"
                          subject="filament_extrude_length_25mm_active" ref_value="0"/>
              <bind_state_if cond="filament_operation_in_progress eq 1" state="disabled"/>
              <event_cb trigger="clicked" callback="on_filament_extrude_length_25mm"/>
            </ui_button>
          </lv_obj>
          <lv_obj width="100%"
                  height="#button_height_lg" style_pad_all="0" scrollable="false" flex_flow="row"
                  style_flex_main_place="space_between" style_flex_cross_place="center" style_pad_gap="#space_sm"
                  style_min_height="#button_height">
            <ui_button name="btn_extrude"
                       width="0" height="100%" flex_grow="1" icon="arrow_down" text="Extrude" translation_tag="Extrude"
                       style_text_font="#font_body_bold" bind_op_state="filament_op_extrude_state" layout="column"
                       style_radius="#border_radius" variant="outline" style_bg_color="#card_bg"
                       style_border_color="#border">
              <event_cb trigger="clicked" callback="on_filament_extrude"/>
              <bind_state_if cond="filament_operation_in_progress eq 1 or filament_extrusion_allowed eq 0 or filament_heat_state ne 2 or filament_tool_is_active eq 0"
                             state="disabled"/>
            </ui_button>
            <ui_button name="btn_retract"
                       width="0" height="100%" flex_grow="1" icon="arrow_up" text="Retract" translation_tag="Retract"
                       style_text_font="#font_body_bold" bind_op_state="filament_op_retract_state" layout="column"
                       style_radius="#border_radius" variant="outline" style_bg_color="#card_bg"
                       style_border_color="#border">
              <event_cb trigger="clicked" callback="on_filament_retract"/>
              <bind_state_if cond="filament_operation_in_progress eq 1 or filament_extrusion_allowed eq 0 or filament_heat_state ne 2 or filament_tool_is_active eq 0"
                             state="disabled"/>
            </ui_button>
          </lv_obj>
          <ui_button name="btn_purge"
                     width="100%" height="#button_height_lg" icon="trash_can_outline" text="Purge"
                     translation_tag="Purge" style_text_font="#font_body_bold" bind_op_state="filament_op_purge_state"
                     layout="row" style_radius="#border_radius" variant="outline" style_bg_color="#card_bg"
                     style_border_color="#border">
            <event_cb trigger="clicked" callback="on_filament_purge"/>
            <bind_state_if cond="filament_operation_in_progress eq 1 or filament_extrusion_allowed eq 0 or filament_heat_state ne 2 or filament_tool_is_active eq 0"
                           state="disabled"/>
          </ui_button>
          <lv_obj name="safety_warning"
                  width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="row"
                  style_flex_main_place="start" style_flex_cross_place="center" style_flex_track_place="center"
                  style_pad_gap="#space_xs">
            <bind_flag_if cond="filament_extrusion_allowed eq 1 and filament_heat_state eq 2" flag="hidden"/>
            <icon src="thermometer" size="sm" variant="warning"/>
            <text_small width="0"
                        text="Heat nozzle first" translation_tag="Heat nozzle first" flex_grow="1" long_mode="wrap"/>
          </lv_obj>
          <else/>
          <lv_obj name="no_tool_hint"
                  width="100%" height="100%" style_pad_all="#space_lg" scrollable="false" flex_flow="column"
                  style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="#space_sm"
                  style_bg_color="#card_bg" style_bg_opa="255" style_radius="#border_radius" style_border_width="1"
                  style_border_color="#border">
            <icon src="filament" size="md" variant="tertiary"/>
            <text_body width="100%"
                       text="No active tool" translation_tag="No active tool" long_mode="wrap" style_text_align="center"/>
            <text_small width="100%"
                        text="Activate a tool to use filament controls."
                        translation_tag="Activate a tool to use filament controls." long_mode="wrap"
                        style_text_align="center" style_text_color="#text_muted"/>
          </lv_obj>
        </if>
      </lv_obj>
    </lv_obj>
  </view>
</component>
