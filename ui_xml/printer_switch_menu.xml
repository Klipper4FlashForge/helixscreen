<component>
  <!-- Full-screen backdrop overlay - tap to dismiss -->
  <view name="printer_switch_menu" extends="context_menu_backdrop">
    <!-- Context menu card - width and position set dynamically by C++ -->
    <lv_obj name="context_menu"
            width="content" height="content" style_bg_color="#elevated_bg" style_bg_opa="255"
            style_radius="#border_radius" style_pad_all="#space_sm" style_pad_gap="#space_sm" style_min_width="160"
            flex_flow="column" scrollable="false" clickable="true">
      <!-- Header row: title + close. Backdrop tap still dismisses. -->
      <lv_obj width="100%"
              height="content" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center"
              style_pad_all="0" scrollable="false" clickable="false" event_bubble="true">
        <text_small text="Switch Printer"
                    translation_tag="Switch Printer" style_text_color="#text_muted" clickable="false"
                    event_bubble="true"/>
        <ui_button name="btn_close" width="content" height="content" variant="ghost" icon="close" style_pad_right="0">
          <event_cb trigger="clicked" callback="context_menu_close_cb"/>
        </ui_button>
      </lv_obj>
      <lv_obj width="100%"
              height="1" style_bg_color="#text_muted" style_bg_opa="38" style_pad_all="0" scrollable="false"/>
      <!-- Printer rows populated dynamically by C++ -->
      <!-- max_height set dynamically by C++ to ~2/3 screen height -->
      <lv_obj name="printer_list"
              width="100%" height="content" flex_flow="column" style_pad_all="0" style_pad_gap="0" scrollable="true"/>
      <lv_obj width="100%"
              height="1" style_bg_color="#text_muted" style_bg_opa="38" style_pad_all="0" scrollable="false"/>
      <ui_button name="btn_add_printer"
                 width="100%" text="+ Add Printer" translation_tag="+ Add Printer" variant="ghost">
        <event_cb trigger="clicked" callback="printer_switch_add_cb"/>
      </ui_button>
    </lv_obj>
  </view>
</component>
