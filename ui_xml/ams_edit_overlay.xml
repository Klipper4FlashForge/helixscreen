<!-- AMS slot editor overlay. One overlay, internal views selected by the
     ams_edit_view int subject: 0=overview (form), 1=Spoolman spool picker.
     Header bar: back button (per-view routing via ams_edit_back_cb) and a
     dirty-gated Save action (ams_edit_save_disabled subject), hidden outside
     the overview via ams_edit_save_hidden. Both subjects are written
     exclusively by AmsEditOverlay::set_view(). -->
<component>
  <consts>
    <px name="left_column_width" value="120"/>
    <!-- Spool-picker list max height: caps the scroll viewport so the picker
         stays inside the overlay. Tuned to show ~5 rows at each breakpoint. -->
    <px name="spool_list_max_height_micro" value="130"/>
    <px name="spool_list_max_height_tiny" value="150"/>
    <px name="spool_list_max_height_small" value="180"/>
    <px name="spool_list_max_height_medium" value="250"/>
    <px name="spool_list_max_height_large" value="330"/>
    <px name="spool_list_max_height_xlarge" value="420"/>
    <px name="spool_list_max_height_xxlarge" value="520"/>
    <!-- Spool-details Notes field height (mirrors spoolman_edit_modal) -->
    <px name="notes_height_small" value="44"/>
    <px name="notes_height_medium" value="72"/>
    <px name="notes_height_large" value="88"/>
  </consts>
  <view name="ams_edit_overlay"
        extends="overlay_panel" width="#overlay_panel_width"
        title="Edit Slot" title_tag="Edit Slot"
        hide_action_button="false"
        action_button_text="Save" action_button_text_tag="Save"
        action_button_callback="ams_edit_save_cb"
        action_button_disabled_subject="ams_edit_save_disabled"
        action_button_hidden_subject="ams_edit_save_hidden"
        back_button_callback="ams_edit_back_cb">
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_all="0" flex_flow="column"
            style_pad_gap="0" scrollbar_mode="auto">

      <!-- ============================================================ -->
      <!-- OVERVIEW VIEW: slot state + manual edit (ams_edit_view=0)    -->
      <!-- ============================================================ -->
      <lv_obj name="form_view" width="100%" flex_grow="1" flex_flow="column" style_pad_gap="0"
              style_flex_main_place="center" scrollable="false">
        <bind_flag_if_not_eq subject="ams_edit_view" flag="hidden" ref_value="0"/>
        <!-- Content area - HORIZONTAL layout with side-by-side sections -->
        <lv_obj width="100%"
                height="content" style_pad_all="#space_lg" flex_flow="row" style_pad_gap="#space_xl" scrollable="false">
          <!-- LEFT COLUMN: Tool remap + Color preview -->
          <lv_obj width="#left_column_width"
                  height="content" style_pad_all="0" flex_flow="column" style_flex_main_place="start"
                  style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
            <!-- Tool assignment dropdown (hidden when backend doesn't support remapping) -->
            <lv_obj name="tool_remap_row" width="100%" height="content" style_pad_all="0" flex_flow="column"
                    style_pad_gap="#space_xxs" scrollable="false" hidden="true">
              <text_small text="Remap Tool" translation_tag="Remap Tool"/>
              <lv_dropdown name="tool_dropdown"
                           width="100%" height="content" style_radius="#border_radius"
                           style_border_width="0" options="None">
                <event_cb trigger="value_changed" callback="ams_edit_tool_changed_cb"/>
              </lv_dropdown>
            </lv_obj>
            <!-- Large color swatch (tappable to open picker) -->
            <lv_obj name="color_swatch"
                    width="#color_preview_size" height="#color_preview_size" style_radius="#border_radius"
                    style_bg_color="#card_bg" style_bg_opa="255" style_border_width="2" style_border_color="#text_muted"
                    style_border_opa="80" scrollable="false" clickable="true">
              <event_cb trigger="clicked" callback="ams_edit_color_clicked_cb"/>
              <!-- Edit overlay hint -->
              <icon src="pencil" size="sm" variant="tertiary" align="bottom_right" style_opa="180"/>
            </lv_obj>
            <!-- Color name label below swatch -->
            <text_small name="color_name_label" text="Gray" translation_tag="Gray" width="100%" long_mode="wrap" style_text_align="center"/>
            <!-- Filament product-line name (e.g. "SnapSpeed", "PolyLite PLA") -->
            <text_small name="spool_name_label" text="" width="100%" long_mode="wrap" style_text_align="center" style_text_color="#text_muted" hidden="true"/>
          </lv_obj>
          <!-- RIGHT COLUMN: Form fields -->
          <lv_obj flex_grow="1"
                  style_pad_all="0" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="start"
                  style_pad_gap="#space_md" scrollable="false">
            <!-- Identity chip: read-only summary of the filament identity.
                 Tap opens the identity picker (Spoolman connected) or the
                 filament-details view (Phase 5). Tracked slots show the spool
                 name + tintable Spoolman mark; untracked show "Brand · Material".
                 The "Filament" label keeps this row height-aligned with the
                 left column's "Remap Tool" label + dropdown. -->
            <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="column"
                    style_pad_gap="#space_xxs" scrollable="false">
            <text_small text="Filament" translation_tag="Filament"/>
            <!-- Flat progressive row (same treatment as spool_details_row) —
                 an elevated box here reads as a dropdown next to the real
                 Remap Tool dropdown. -->
            <lv_obj name="identity_chip" width="100%" height="content"
                    style_pad_all="#space_xs" style_radius="#border_radius"
                    flex_flow="row" style_flex_cross_place="center"
                    style_pad_gap="#space_sm" clickable="true" scrollable="false">
              <event_cb trigger="clicked" callback="ams_edit_chip_clicked_cb"/>
              <text_body name="chip_label" text="Generic · PETG" flex_grow="1"
                         long_mode="dots" clickable="false"/>
              <!-- Trailing Spoolman-tracked badge. Rendered at the asset's
                   intrinsic 24px (spoolman_24.png) and tinted via recolor.
                   A runtime scale transform is deliberately avoided: LVGL
                   applies scale around the pivot AFTER inner_align re-centers
                   the source area on the widget box, so a scaled-down source
                   in a smaller widget lands entirely outside the clip rect and
                   renders nothing. Intrinsic sizing matches the AMS logo path. -->
              <lv_image name="chip_spoolman_mark" src="spoolman_mark"
                        style_image_recolor="#text_muted" style_image_recolor_opa="255"
                        hidden="true" clickable="false">
                <bind_flag_if_eq subject="ams_edit_is_managed" flag="hidden" ref_value="0"/>
              </lv_image>
              <icon src="chevron_right" size="sm" variant="muted" clickable="false"/>
            </lv_obj>
            <!-- Spool logistics entry — managed spools only (spec §3.6).
                 Sits directly under the Filament row so the two navigation
                 rows read as a group. -->
            <lv_obj name="spool_details_row" width="100%" height="content"
                    style_pad_all="#space_xs" style_radius="#border_radius"
                    flex_flow="row" style_flex_main_place="space_between"
                    style_flex_cross_place="center" clickable="true" scrollable="false"
                    hidden="true">
              <bind_flag_if_eq subject="ams_edit_is_managed" flag="hidden" ref_value="0"/>
              <event_cb trigger="clicked" callback="ams_edit_spool_details_cb"/>
              <text_body text="Edit spool details" translation_tag="Edit spool details" clickable="false"/>
              <icon src="chevron_right" size="sm" variant="muted" clickable="false"/>
            </lv_obj>
            </lv_obj>
            <!-- Remaining weight section (extra padding for slider handle) -->
            <lv_obj width="100%"
                    height="content" style_pad_left="#space_sm" style_pad_right="#space_sm"
                    style_pad_top="#space_xxs" style_pad_bottom="#space_xxs"
                    flex_flow="column" style_flex_main_place="start"
                    style_flex_cross_place="start" style_pad_gap="#space_xxs" scrollable="false">
              <!-- Header row with label, percentage, and edit button -->
              <lv_obj width="100%"
                      height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                      style_flex_cross_place="center" scrollable="false">
                <text_small text="Remaining" translation_tag="Remaining"/>
                <lv_obj height="content"
                        style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_xs"
                        scrollable="false">
                  <!-- Weight input (shown when weight data available) -->
                  <text_input name="remaining_weight_input" width="60" max_length="5"
                              keyboard_hint="numeric" hidden="true">
                    <event_cb trigger="value_changed" callback="ams_edit_weight_changed_cb"/>
                  </text_input>
                  <!-- Info label: "/ 1000g (75%)" or just "100%" when no weight data -->
                  <text_body name="remaining_pct_label" text="100%"/>
                  <!-- Edit button (shown when edit_remaining_mode=0) -->
                  <ui_button name="btn_remaining_edit"
                             width="#icon_button_size" height="#icon_button_size" icon="tune" variant="ghost">
                    <bind_flag_if_eq subject="edit_remaining_mode" flag="hidden" ref_value="1"/>
                    <event_cb trigger="clicked" callback="ams_edit_remaining_edit_cb"/>
                  </ui_button>
                  <!-- Accept button (shown when edit_remaining_mode=1) -->
                  <ui_button name="btn_remaining_accept"
                             width="#icon_button_size" height="#icon_button_size" icon="check" variant="ghost"
                             hidden="true">
                    <bind_flag_if_eq subject="edit_remaining_mode" flag="hidden" ref_value="0"/>
                    <event_cb trigger="clicked" callback="ams_edit_remaining_accept_cb"/>
                  </ui_button>
                  <!-- Cancel button (shown when edit_remaining_mode=1) -->
                  <ui_button name="btn_remaining_cancel"
                             width="#icon_button_size" height="#icon_button_size" icon="close" variant="ghost"
                             hidden="true">
                    <bind_flag_if_eq subject="edit_remaining_mode" flag="hidden" ref_value="0"/>
                    <event_cb trigger="clicked" callback="ams_edit_remaining_cancel_cb"/>
                  </ui_button>
                </lv_obj>
              </lv_obj>
              <!-- Progress bar (shown when edit_remaining_mode=0) -->
              <lv_obj name="remaining_progress_container"
                      width="100%" height="#slider_height" style_bg_color="#text_muted" style_bg_opa="38"
                      style_radius="#border_radius" style_pad_all="0" scrollable="false">
                <bind_flag_if_eq subject="edit_remaining_mode" flag="hidden" ref_value="1"/>
                <lv_obj name="remaining_progress_fill"
                        width="100%" height="100%" style_bg_color="#primary" style_bg_opa="255" style_radius="#border_radius"
                        style_pad_all="0" scrollable="false"/>
              </lv_obj>
              <!-- Slider (shown when edit_remaining_mode=1) -->
              <lv_slider name="remaining_slider"
                         width="100%" height="#slider_height" style_radius="#border_radius" value="100" min_value="0"
                         max_value="100" hidden="true">
                <bind_flag_if_eq subject="edit_remaining_mode" flag="hidden" ref_value="0"/>
                <event_cb trigger="value_changed" callback="ams_edit_remaining_changed_cb"/>
              </lv_slider>
            </lv_obj>
            <!-- Temperature display (compact, read-only) -->
            <lv_obj width="100%"
                    height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="start"
                    style_pad_gap="#space_lg" scrollable="false">
              <lv_obj height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs" scrollable="false">
                <text_small text="Nozzle:" translation_tag="Nozzle:"/>
                <text_small name="temp_nozzle_label" text="200-230°C"/>
              </lv_obj>
              <lv_obj height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs" scrollable="false">
                <text_small text="Bed:" translation_tag="Bed:"/>
                <text_small name="temp_bed_label" text="60°C"/>
              </lv_obj>
            </lv_obj>
          </lv_obj>
        </lv_obj>
        <!-- Filament actions: Scan QR is the identity fast path for both
             linked and unlinked slots (Unlink lives in the identity picker;
             Print Label lives in Spool details). Visibility managed in
             update_spoolman_button_state(). -->
        <lv_obj name="spoolman_actions"
                width="100%" height="content" style_pad_left="#space_md" style_pad_right="#space_md"
                style_pad_top="0" style_pad_bottom="#space_sm"
                flex_flow="row_wrap" style_flex_main_place="center" style_pad_gap="#space_sm"
                scrollable="false">
          <ui_button name="btn_scan_qr_code"
                     height="#button_height" text="Scan QR Code"
                     translation_tag="Scan QR Code" variant="secondary"
                     icon="qrcode_scan">
            <event_cb trigger="clicked" callback="ams_edit_scan_qr_cb"/>
          </ui_button>
        </lv_obj>
      </lv_obj>

      <!-- ============================================================ -->
      <!-- PICKER VIEW: Spoolman spool selection (ams_edit_view=1)      -->
      <!-- ============================================================ -->
      <lv_obj name="picker_view"
              width="100%" height="content" flex_flow="column" style_pad_all="#space_md" style_pad_gap="#space_sm"
              scrollable="false" hidden="true">
        <bind_flag_if_not_eq subject="ams_edit_view" flag="hidden" ref_value="1"/>

        <!-- Search filter -->
        <text_input name="picker_search"
                    width="100%" placeholder_text="Search spools..." placeholder_tag="Search spools...">
          <event_cb trigger="value_changed" callback="ams_edit_picker_search_cb"/>
        </text_input>

        <!-- Loading state -->
        <lv_obj name="picker_loading"
                width="100%" height="120" flex_flow="column" style_flex_main_place="center"
                style_flex_cross_place="center" style_pad_all="0" scrollable="false">
          <bind_flag_if_not_eq subject="edit_picker_state" flag="hidden" ref_value="0"/>
          <lv_spinner width="32"
                      height="32" style_arc_width-indicator="2" style_arc_color="#primary" style_arc_opa-main="0"/>
          <text_body text="Loading spools..." translation_tag="Loading spools..." style_pad_top="#space_sm"/>
        </lv_obj>

        <!-- Empty state -->
        <lv_obj name="picker_empty" width="100%" height="120" scrollable="false" hidden="true"
                clickable="true">
          <bind_flag_if_not_eq subject="edit_picker_state" flag="hidden" ref_value="1"/>
          <event_cb trigger="clicked" callback="ams_edit_picker_retry_cb"/>
          <empty_state icon="spoolman" text="No spools found — tap to retry" translation_tag="No spools found — tap to retry"
                       clickable="false" event_bubble="true"/>
        </lv_obj>

        <!-- Spool list (populated dynamically by C++) -->
        <lv_obj name="picker_spool_list"
                width="100%" height="content" style_max_height="#spool_list_max_height"
                style_pad_all="#space_xxs" style_radius="#border_radius"
                style_pad_gap="#space_xxs" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="start"
                style_bg_color="#card_bg" style_bg_opa="255" scrollable="true" hidden="true">
          <bind_flag_if_not_eq subject="edit_picker_state" flag="hidden" ref_value="2"/>
        </lv_obj>

        <!-- Escape hatch to untracked setup — locked naming (spec §3.8).
             Outlined (border) row, visually distinct from spool rows; always
             visible, including the empty state (resolution §2.4). -->
        <lv_obj name="picker_setup_entry" width="100%" height="content"
                style_bg_opa="0" style_border_width="1" style_border_color="#text_muted"
                style_border_opa="120" style_radius="#border_radius"
                style_pad_all="#space_sm" flex_flow="row" style_flex_main_place="center"
                clickable="true" scrollable="false">
          <event_cb trigger="clicked" callback="ams_edit_setup_entry_cb"/>
          <text_body text="Not in your spools? Set it up →"
                     translation_tag="Not in your spools? Set it up →" clickable="false"/>
        </lv_obj>

        <!-- Unlink: identity change to untracked — only offered while the
             slot is linked. Same outlined treatment as the setup entry. -->
        <lv_obj name="picker_unlink_entry" width="100%" height="content"
                style_bg_opa="0" style_border_width="1" style_border_color="#text_muted"
                style_border_opa="120" style_radius="#border_radius"
                style_pad_all="#space_sm" flex_flow="row" style_flex_main_place="center"
                clickable="true" scrollable="false" hidden="true">
          <bind_flag_if_eq subject="ams_edit_is_managed" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="ams_edit_picker_unlink_cb"/>
          <text_body text="Unlink from Spoolman"
                     translation_tag="Unlink from Spoolman" clickable="false"/>
        </lv_obj>

      </lv_obj>

      <!-- ============================================================ -->
      <!-- FILAMENT DETAILS VIEW (ams_edit_view=2): untracked setup AND -->
      <!-- identity editing for the current filament (spec §3.3)        -->
      <!-- ============================================================ -->
      <lv_obj name="details_view"
              width="100%" height="content" flex_flow="column" style_pad_all="#space_md"
              style_pad_gap="#space_md" scrollable="false" hidden="true">
        <bind_flag_if_not_eq subject="ams_edit_view" flag="hidden" ref_value="2"/>

        <text_heading text="Filament details" translation_tag="Filament details"/>

        <!-- Brand / Material / product — shared catalog selector fragment -->
        <filament_catalog_selector name="details_catalog_selector"/>

        <!-- Inline color: shared full preset palette (one palette everywhere)
             + custom-hue affordance (✎ opens the color view: swatches + HSV) -->
        <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="column"
                style_pad_gap="#space_xs" scrollable="false">
          <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row"
                  style_pad_gap="#space_sm" style_flex_cross_place="center" scrollable="false">
            <text_small text="Color" translation_tag="Color"/>
            <!-- Selected-color preview -->
            <lv_obj name="details_color_preview" width="28" height="28"
                    style_radius="#border_radius_small" style_bg_color="#card_bg" style_bg_opa="255"
                    style_border_width="2" style_border_color="#text_muted" style_border_opa="80"
                    scrollable="false"/>
            <!-- Custom-hue escape hatch: opens the color view (swatches + HSV) -->
            <ui_button name="btn_details_custom_color" width="28" height="28"
                       icon="pencil" variant="ghost">
              <event_cb trigger="clicked" callback="ams_edit_custom_color_cb"/>
            </ui_button>
          </lv_obj>
          <color_swatch_grid swatch_callback="ams_edit_quick_swatch_cb"/>
        </lv_obj>

        <!-- Save to Spoolman toggle — locked naming (spec §3.8). Absent when
             Spoolman is disconnected; defaults to the slot's managed state. -->
        <lv_obj name="save_to_spoolman_row" width="100%" height="content" style_pad_all="0"
                flex_flow="row" style_flex_main_place="space_between"
                style_flex_cross_place="center" scrollable="false">
          <bind_flag_if_eq subject="printer_has_spoolman" flag="hidden" ref_value="0"/>
          <text_body text="Save to Spoolman" translation_tag="Save to Spoolman"/>
          <ui_switch name="save_to_spoolman_switch" size="small">
            <bind_state_if_eq subject="ams_edit_is_managed" state="checked" ref_value="1"/>
          </ui_switch>
        </lv_obj>

        <!-- Select: apply to the working slot and return to the overview -->
        <ui_button name="btn_details_select" width="100%" height="#button_height"
                   text="Select" translation_tag="Select" variant="primary">
          <event_cb trigger="clicked" callback="ams_edit_details_select_cb"/>
        </ui_button>
      </lv_obj>

      <!-- ============================================================ -->
      <!-- COLOR VIEW (ams_edit_view=3): one screen — preset grid AND   -->
      <!-- custom HSV side by side. A preset tap applies immediately;   -->
      <!-- HSV/hex + Select applies a custom color. Returns to          -->
      <!-- return_view_ (overview or filament-details).                 -->
      <!-- ============================================================ -->
      <lv_obj name="color_view"
              width="100%" flex_grow="1" flex_flow="row" style_pad_all="#space_lg"
              style_pad_gap="#space_xl" style_flex_main_place="center"
              style_flex_cross_place="center" scrollable="false" hidden="true">
        <bind_flag_if_not_eq subject="ams_edit_view" flag="hidden" ref_value="3"/>

        <!-- Preset swatches: tap applies + returns -->
        <lv_obj flex_grow="1" height="content" style_pad_all="0"
                flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
          <text_small text="Presets" translation_tag="Presets"/>
          <color_swatch_grid swatch_callback="ams_edit_color_swatch_cb"/>
        </lv_obj>

        <!-- Custom hue: HSV + hex + Select -->
        <lv_obj width="content" height="content" style_pad_all="0" flex_flow="row"
                style_pad_gap="#space_md" style_flex_cross_place="center" scrollable="false">
          <ui_hsv_picker name="ams_color_hsv" sv_size="#sv_size" hue_height="#hue_height"
                         gap="#space_sm"/>
          <lv_obj width="content" height="content" style_pad_all="0" flex_flow="column"
                  style_flex_main_place="start" style_flex_cross_place="start"
                  style_pad_gap="#space_sm" scrollable="false">
            <lv_obj name="ams_color_preview" width="#color_preview_size"
                    height="#color_preview_size_small" style_radius="#border_radius"
                    style_bg_color="#card_bg" style_bg_opa="255" style_border_width="2"
                    style_border_color="#text_muted" style_border_opa="80" scrollable="false"/>
            <text_input name="ams_color_hex_input" width="100" height="content" max_length="9"
                        text="#808080" placeholder_text="#RRGGBB"
                        style_border_width="0" style_outline_width="0" scrollable="false">
              <event_cb trigger="value_changed" callback="ams_edit_color_hex_changed_cb"/>
            </text_input>
            <ui_button name="btn_color_apply" width="100" height="#button_height_sm"
                       text="Select" translation_tag="Select" variant="primary">
              <event_cb trigger="clicked" callback="ams_edit_color_apply_cb"/>
            </ui_button>
          </lv_obj>
        </lv_obj>
      </lv_obj>

      <!-- ============================================================ -->
      <!-- SPOOL DETAILS VIEW (ams_edit_view=4): spool-attribute layer  -->
      <!-- for managed spools only (spec §3.6). Immediate Spoolman      -->
      <!-- write on its own Save; Back returns without writing.         -->
      <!-- ============================================================ -->
      <lv_obj name="spool_details_view"
              width="100%" height="content" flex_flow="column" style_pad_all="#space_md"
              style_pad_gap="#space_sm" scrollable="false" hidden="true">
        <bind_flag_if_not_eq subject="ams_edit_view" flag="hidden" ref_value="4"/>

        <text_heading text="Spool details" translation_tag="Spool details"/>

        <!-- Row 1: Remaining (g) | Spool wt (g) | Price -->
        <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row"
                style_pad_gap="#space_md" scrollable="false">
          <lv_obj height="content" flex_grow="1" style_pad_all="0" flex_flow="column"
                  style_pad_gap="#space_xxs" scrollable="false">
            <text_small text="Remaining (g)" translation_tag="Remaining (g)"/>
            <text_input name="detail_field_remaining" width="100%" keyboard_hint="numeric"
                        placeholder="1000" max_length="8">
              <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
            </text_input>
          </lv_obj>
          <lv_obj height="content" flex_grow="1" style_pad_all="0" flex_flow="column"
                  style_pad_gap="#space_xxs" scrollable="false">
            <text_small text="Spool wt (g)" translation_tag="Spool wt (g)"/>
            <text_input name="detail_field_spool_weight" width="100%" keyboard_hint="numeric"
                        placeholder="0" max_length="8">
              <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
            </text_input>
          </lv_obj>
          <lv_obj height="content" flex_grow="1" style_pad_all="0" flex_flow="column"
                  style_pad_gap="#space_xxs" scrollable="false">
            <text_small text="Price" translation_tag="Price"/>
            <text_input name="detail_field_price" width="100%" keyboard_hint="numeric"
                        placeholder="0.00" max_length="10">
              <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
            </text_input>
          </lv_obj>
        </lv_obj>
        <!-- Row 2: Location | Lot/Batch Nr -->
        <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row"
                style_pad_gap="#space_md" scrollable="false">
          <lv_obj height="content" flex_grow="1" style_pad_all="0" flex_flow="column"
                  style_pad_gap="#space_xxs" scrollable="false">
            <text_small text="Location" translation_tag="Location"/>
            <text_input name="detail_field_location" width="100%" placeholder="Shelf A"
                        placeholder_tag="Shelf A" max_length="64">
              <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
            </text_input>
          </lv_obj>
          <lv_obj height="content" flex_grow="1" style_pad_all="0" flex_flow="column"
                  style_pad_gap="#space_xxs" scrollable="false">
            <text_small text="Lot/Batch Nr" translation_tag="Lot/Batch Nr"/>
            <text_input name="detail_field_lot_nr" width="100%" placeholder="" max_length="32">
              <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
