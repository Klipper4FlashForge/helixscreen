          </lv_obj>
        </lv_obj>
        <!-- Row 3: Notes (full width) -->
        <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="column"
                style_pad_gap="#space_xxs" scrollable="false">
          <text_small text="Notes" translation_tag="Notes"/>
          <text_input name="detail_field_comment" width="100%" height="#notes_height"
                      placeholder="" max_length="256" multiline="true">
            <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
          </text_input>
        </lv_obj>

        <ui_button name="btn_detail_save" width="100%" height="#button_height"
