<component>
  <view name="filament_panel"
        extends="lv_obj" width="100%" height="100%" style_border_width="0" style_pad_all="#space_md" scrollable="false"
        flex_flow="column" style_pad_gap="#space_sm" style_bg_color="#screen_bg">
    <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
    <!-- Every heater card opens its own preheat dialog. Keep the reactive
         repeat in its own container so topology changes cannot reorder the footer. -->
    <lv_obj name="body_row"
            width="100%" height="0" flex_grow="1" style_pad_all="0" scrollable="false" flex_flow="row"
            style_flex_cross_place="start" style_pad_gap="#space_md">
      <lv_obj name="tool_row"
              width="60%" height="100%" style_pad_all="0" scrollable="false" flex_flow="column"
              style_flex_main_place="start" style_flex_cross_place="center" style_pad_gap="#space_sm">
        <text_small width="100%" text="Tools" translation_tag="Tools" long_mode="wrap" style_text_color="#text_muted"/>
        <lv_obj name="tool_chips"
                width="100%" height="0" flex_grow="1" style_pad_all="0" scrollable="true" flex_flow="column"
                style_flex_main_place="start" style_flex_cross_place="center" style_pad_gap="#space_xxs"
                scroll_dir="ver">
          <repeat count="tool_count">
            <lv_obj name="tool_entry_${i}"
                    width="100%" height="0" flex_grow="1" style_min_height="#button_height_lg" flex_flow="row"
                    style_pad_all="0" style_pad_gap="#space_sm" scrollable="false">
              <tool_chip name="tool_chip_${i}"
                         width="0" height="100%" index="$i" flex_grow="1" style_min_height="#button_height_lg"/>

              <ui_button name="tool_mount_${i}"
                         width="#button_height_lg" height="100%" variant="outline" style_bg_color="#card_bg">
                <bind_flag_if cond="ams_type ne 4 and ams_type ne 7" flag="hidden"/>
                <bind_state_if cond="ams_action ne 0 or printer_connection_state ne 2 or print_lifecycle eq 1 or print_lifecycle eq 2"
                               state="disabled"/>
                <event_cb trigger="clicked" callback="on_filament_tool_pick"/>
                <icon src="download" size="lg" variant="text" align="center" ignore_layout="true"
                      style_transform_scale_x="213" style_transform_scale_y="213"
                      clickable="false" event_bubble="true">
                  <bind_flag_if_eq subject="active_tool" ref_value="$i" flag="hidden"/>
                </icon>
                <icon src="eject" size="lg" variant="primary" align="center" ignore_layout="true"
                      style_transform_scale_x="213" style_transform_scale_y="213"
                      clickable="false" event_bubble="true">
                  <bind_flag_if_not_eq subject="active_tool" ref_value="$i" flag="hidden"/>
                </icon>
              </ui_button>

              <ui_button name="tool_gear_${i}"
                         width="#button_height_lg" height="100%" variant="outline"
                         style_bg_color="#card_bg">
                <bind_state_if_not_eq subject="active_tool" state="disabled" ref_value="$i"/>
                <event_cb trigger="clicked" callback="on_filament_tool_dialog_open"/>
                <icon name="tool_gear_${i}_icon" src="filament" size="lg" variant="text" align="center"
                      ignore_layout="true" style_transform_scale_x="213" style_transform_scale_y="213"
                      clickable="false" event_bubble="true"/>
              </ui_button>
            </lv_obj>
          </repeat>
        </lv_obj>
      </lv_obj>
      <lv_obj name="content_column"
              width="0" height="100%" flex_grow="1" style_pad_all="0" scrollable="false" flex_flow="column"
              style_pad_gap="#space_sm">
        <text_small name="heaters_heading"
                    width="100%" text="Heaters" translation_tag="Heaters" long_mode="wrap"
                    style_text_color="#text_muted"/>
        <!-- Bed and chamber remain available even when every tool is docked. -->
        <lv_obj name="global_heaters"
                width="100%" height="0" style_pad_all="0" scrollable="false" flex_flow="column"
                style_pad_gap="#space_sm" flex_grow="1">
          <heater_summary_card name="bed_target_tap"
                               width="100%" height="0" heater="bed" title="Bed" accent="#temp_gradient_warm"
                               current_subject="filament_bed_current" target_subject="filament_bed_target"
                               callback="on_filament_bed_target_tap" flex_grow="1" card_flow="row" stripe_width="2"
                               stripe_height="100%" body_width="0" body_height="100%"/>
          <heater_summary_card name="chamber_section"
                               width="100%" height="0" heater="chamber" title="Chamber" accent="#temp_gradient_cold"
                               current_subject="filament_chamber_current" target_subject="filament_chamber_target"
                               callback="on_filament_chamber_target_tap" flex_grow="1" card_flow="row" stripe_width="2"
                               stripe_height="100%" body_width="0" body_height="100%">
            <bind_flag_if_eq subject="printer_has_chamber" flag="hidden" ref_value="0"/>
            <bind_state_if_eq subject="printer_has_chamber_heater" state="disabled" ref_value="0"/>
          </heater_summary_card>
        </lv_obj>
        <ui_card name="spool_card"
                 width="100%" height="content" style_radius="#border_radius" style_pad_ver="#space_xs"
                 style_pad_hor="#space_md" style_pad_gap="#space_xxs" flex_flow="column" style_flex_main_place="center"
                 style_flex_cross_place="center" hidden="true">
          <lv_obj name="spool_card_header_row"
                  width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="row"
                  style_flex_main_place="start" style_flex_cross_place="center" style_pad_gap="#space_sm" hidden="true">
            <icon src="filament" size="sm" variant="secondary"/>
            <text_body bind_text="filament_card_title"
                       translation_tag="Multi-Filament" text_transform="uppercase" style_translate_y="2"/>
          </lv_obj>
          <lv_obj name="external_spool_row"
                  width="100%" height="content" style_pad_all="0" scrollable="false" clickable="true" flex_flow="row"
                  style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="#space_sm" hidden="true">
            <style name="styles.press_wash" selector="pressed"/>
            <event_cb trigger="clicked" callback="on_external_spool_edit"/>
            <lv_obj name="external_spool_container"
                    width="48" height="48" style_pad_all="0" scrollable="false" clickable="false" event_bubble="true"/>
            <lv_obj height="content"
                    flex_grow="1" style_pad_all="0" scrollable="false" flex_flow="column" style_flex_main_place="center"
                    style_flex_cross_place="start" style_pad_gap="2" clickable="false" event_bubble="true">
              <text_body name="external_spool_material_label"
                         text="No spool assigned" translation_tag="No spool assigned" clickable="false"
                         event_bubble="true"/>
              <text_small name="external_spool_color_label"
                          text="Tap to assign" translation_tag="Tap to assign" clickable="false" event_bubble="true"/>
            </lv_obj>
          </lv_obj>
        </ui_card>
        <lv_obj name="filament_footer"
                width="100%" height="content" flex_flow="column" style_pad_all="0" style_pad_gap="#space_sm"
                scrollable="false">
          <ui_button name="btn_cooldown"
                     width="100%" height="#button_height_lg" style_bg_color="#temp_gradient_cold" icon="cooldown"
                     text="Cool Down" translation_tag="Cool Down">
            <event_cb trigger="clicked" callback="on_filament_cooldown"/>
          </ui_button>
          <ui_button name="btn_manage_slots"
                     width="100%" height="#button_height_lg" variant="outline" icon="filament" style_pad_all="0"
                     text="Materials" translation_tag="Materials" style_bg_color="#card_bg"
                     style_text_font="#font_body_bold">
            <event_cb trigger="clicked" callback="filament_manage_slots_cb"/>
            <bind_flag_if_eq subject="ams_type" flag="hidden" ref_value="0"/>
          </ui_button>
        </lv_obj>
      </lv_obj>
    </lv_obj>
  </view>
</component>
