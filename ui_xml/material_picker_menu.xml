<component>
  <!-- Full-screen backdrop overlay - tap to dismiss -->
  <view name="material_picker_menu" extends="lv_obj"
        width="100%" height="100%" style_bg_opa="128" style_bg_color="0x000000"
        style_border_width="0" style_pad_all="0" style_radius="0" clickable="true">
    <event_cb trigger="clicked" callback="material_picker_backdrop_cb"/>
    <!-- Context menu card - position/width set dynamically by C++ -->
    <lv_obj name="context_menu"
            width="content" height="content" style_bg_color="#elevated_bg" style_bg_opa="255"
            style_radius="#border_radius" style_pad_all="#space_sm" style_pad_gap="#space_sm"
            style_min_width="200"
            flex_flow="column" scrollable="false" clickable="true">
      <text_small text="Material" translation_tag="Material" style_text_color="#text_muted"/>
      <!-- Pinned reset action -->
      <ui_button name="btn_reset_presets" text="Reset all to defaults"
                 translation_tag="Reset all to defaults" variant="ghost" width="100%">
        <event_cb trigger="clicked" callback="material_picker_reset_cb"/>
      </ui_button>
      <lv_obj width="100%" height="1" style_bg_color="#text_muted" style_bg_opa="38"
              style_pad_all="0" scrollable="false"/>
      <!-- Material rows populated dynamically by C++; max_height set by C++ to ~2/3 screen -->
      <lv_obj name="material_list" width="100%" height="content"
              flex_flow="column" style_pad_all="0" style_pad_gap="0"
              scrollable="true"/>
    </lv_obj>
  </view>
</component>
