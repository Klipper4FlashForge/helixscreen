<component>
  <!-- Full-screen backdrop overlay - tap to dismiss -->
  <view name="fan_stack_picker"
        extends="lv_obj" width="100%" height="100%" style_bg_opa="128" style_bg_color="0x000000" style_border_width="0"
        style_pad_all="0" style_radius="0" clickable="true">
    <event_cb trigger="clicked" callback="context_menu_backdrop_cb"/>
    <!-- Context menu card - positioned and height-capped by ContextMenu -->
    <lv_obj name="context_menu"
            width="content" height="content" style_bg_color="#elevated_bg" style_bg_opa="255"
            style_radius="#border_radius" style_pad_all="#space_sm" style_pad_gap="#space_xs" flex_flow="column"
            style_flex_main_place="start" style_flex_cross_place="start" scrollable="false" clickable="true">
      <!-- Header row: title + Done. The icon grid below applies live, so Done
           commits nothing - it is the way out that does not need the backdrop. -->
      <lv_obj width="100%"
              height="content" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center"
              style_pad_all="0" scrollable="false" clickable="false" event_bubble="true">
        <text_small text="Configure Fan Widget"
                    translation_tag="Configure Fan Widget" flex_grow="1" long_mode="dots" clickable="false"
                    event_bubble="true"/>
        <ui_button name="btn_done"
                   width="content" height="content" variant="ghost" text="Done" translation_tag="Done" icon="check"
                   style_pad_right="0">
          <event_cb trigger="clicked" callback="context_menu_close_cb"/>
        </ui_button>
      </lv_obj>
      <lv_obj width="100%"
              height="1" style_bg_color="#text_muted" style_bg_opa="38" style_pad_all="0" scrollable="false"
              clickable="false" event_bubble="true"/>
      <text_small text="Display Mode" translation_tag="Display Mode" clickable="false" event_bubble="true"/>
      <!-- Mode rows populated dynamically by C++ -->
      <lv_obj name="mode_list"
              width="100%" height="content" flex_flow="column" style_pad_all="0" style_pad_gap="0" scrollable="false"
              clickable="false"/>
      <lv_obj width="100%"
              height="1" style_bg_color="#text_muted" style_bg_opa="38" style_pad_all="0" scrollable="false"
              clickable="false" event_bubble="true"/>
      <text_small text="Icon" translation_tag="Icon" clickable="false" event_bubble="true"/>
      <!-- Icon cells populated dynamically by C++ -->
      <lv_obj name="icon_grid"
              width="100%" height="content" flex_flow="row_wrap" style_pad_all="0" style_pad_gap="#space_xxs"
              scrollable="false" clickable="false"/>
    </lv_obj>
  </view>
</component>
