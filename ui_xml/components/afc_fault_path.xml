<!-- Graphical replacement for AFC's monospace fault diagram (prestonbrown/helixscreen#1184). -->
<!--                                                                                          -->
<!-- Four checkpoints along the filament path, joined by the three GAPS between them:          -->
<!--                                                                                          -->
<!--   *=======*=======*~~~~~~~o                                                               -->
<!--   Spool   Lane    Hub  Toolhead                                                           -->
<!--                                                                                          -->
<!-- The gap is the unit that matters, because that is where AFC reports failures. Its own     -->
<!-- ASCII art works the same way and is widely misread because of it: ||=====||====||==>~~||  -->
<!-- is THREE sections under FOUR labels, i.e. TRG to LOAD, LOAD to HUB, HUB to TOOL. Traced in      -->
<!-- AFC.py: "did not trigger hub sensor" fires after loaded_to_hub is already true (so the    -->
<!-- LOAD to HUB gap), and "pre extruder gear toolhead sensor" fires while homing down the       -->
<!-- bowden past an already-cleared hub (the HUB to TOOL gap). Painting the checkpoint red        -->
<!-- instead of the gap would say "the hub failed" about a hub the filament passed cleanly.    -->
<!--                                                                                          -->
<!-- Driven entirely by the int subject `afc_fault_segment`, whose values are PathSegment      -->
<!-- (include/ams_types.h). C++ writes it via helix::ui::afc_fault_path_apply():               -->
<!--                                                                                          -->
<!--   0 NONE     - not an AFC message we recognise; the whole component hides                 -->
<!--   1 SPOOL    - never reached the lane trigger          -> Spool..Lane gap fails           -->
<!--   4 HUB      - past the lane, never reached the hub    -> Lane..Hub gap fails             -->
<!--   5 OUTPUT   - past the hub, never reached the head    -> Hub..Toolhead gap fails         -->
<!--   6 TOOLHEAD - past the toolhead sensor, jammed in the extruder gears -> Toolhead fails   -->
<!--                                                                                          -->
<!-- No caret and no caption: a failing gap sits between two named checkpoints, so its         -->
<!-- position is unambiguous on its own. The rail-of-four-cells design this replaced needed    -->
<!-- both, because one red cell among four cannot express "between Hub and Toolhead".          -->
<!--                                                                                          -->
<!-- Every element's bindings are exhaustive and mutually exclusive over the whole int range,  -->
<!-- so exactly one is ever enabled — which is why colour comes from bind_style and NOT from   -->
<!-- an inline style_bg_color (an inline attr is a local style and would win outright).        -->
<component>
  <styles>
    <!-- Filament got here, or through here. -->
    <style name="afc_path_reached" bg_color="#success" radius="#border_radius"/>
    <!-- Where it stopped. -->
    <style name="afc_path_failed" bg_color="#danger" radius="#border_radius"/>
    <!-- Never got this far. -->
    <style name="afc_path_pending" bg_color="#text_muted" radius="#border_radius"/>
  </styles>
  <view extends="lv_obj" width="100%" height="content" flex_flow="column"
        style_pad_all="0" style_pad_gap="#space_xxs" style_bg_opa="0" style_border_width="0"
        scrollable="false">
    <!-- No recognised position => nothing to draw, and the modal reads exactly as before. -->
    <bind_flag_if_eq subject="afc_fault_segment" flag="hidden" ref_value="0"/>

    <lv_obj width="100%" height="content" flex_flow="row" style_pad_all="0" style_pad_gap="0"
            style_bg_opa="0" style_border_width="0" scrollable="false"
            style_flex_cross_place="center">

      <!-- Spool: the filament is always at least here, or there would be no fault to draw. -->
      <lv_obj name="afc_node_spool" width="#space_md" height="#space_md" style_bg_opa="255"
              style_pad_all="0" style_border_width="0" scrollable="false"
              style_radius="#border_radius" style_bg_color="#success"/>

      <lv_obj name="afc_gap_spool_lane" flex_grow="1" height="#space_xxs" style_bg_opa="255"
              style_pad_all="0" style_border_width="0" scrollable="false">
        <bind_style_if_eq name="afc_path_failed" subject="afc_fault_segment" ref_value="1"/>
        <bind_style_if_not_eq name="afc_path_reached" subject="afc_fault_segment" ref_value="1"/>
      </lv_obj>

      <lv_obj name="afc_node_lane" width="#space_md" height="#space_md" style_bg_opa="255"
              style_pad_all="0" style_border_width="0" scrollable="false">
        <bind_style_if_eq name="afc_path_pending" subject="afc_fault_segment" ref_value="1"/>
        <bind_style_if_not_eq name="afc_path_reached" subject="afc_fault_segment" ref_value="1"/>
      </lv_obj>

      <lv_obj name="afc_gap_lane_hub" flex_grow="1" height="#space_xxs" style_bg_opa="255"
              style_pad_all="0" style_border_width="0" scrollable="false">
        <bind_style_if_lt name="afc_path_pending" subject="afc_fault_segment" ref_value="4"/>
        <bind_style_if_eq name="afc_path_failed" subject="afc_fault_segment" ref_value="4"/>
        <bind_style_if_gt name="afc_path_reached" subject="afc_fault_segment" ref_value="4"/>
      </lv_obj>

      <lv_obj name="afc_node_hub" width="#space_md" height="#space_md" style_bg_opa="255"
              style_pad_all="0" style_border_width="0" scrollable="false">
        <bind_style_if_lt name="afc_path_pending" subject="afc_fault_segment" ref_value="5"/>
        <bind_style_if_ge name="afc_path_reached" subject="afc_fault_segment" ref_value="5"/>
      </lv_obj>

      <lv_obj name="afc_gap_hub_toolhead" flex_grow="1" height="#space_xxs" style_bg_opa="255"
              style_pad_all="0" style_border_width="0" scrollable="false">
        <bind_style_if_lt name="afc_path_pending" subject="afc_fault_segment" ref_value="5"/>
        <bind_style_if_eq name="afc_path_failed" subject="afc_fault_segment" ref_value="5"/>
        <bind_style_if_gt name="afc_path_reached" subject="afc_fault_segment" ref_value="5"/>
      </lv_obj>

      <!-- Toolhead: red when the filament got PAST the sensor and jammed in the extruder
           gears — the one fault that happens AT a checkpoint rather than in a gap. -->
      <lv_obj name="afc_node_toolhead" width="#space_md" height="#space_md" style_bg_opa="255"
              style_pad_all="0" style_border_width="0" scrollable="false">
        <bind_style_if_lt name="afc_path_pending" subject="afc_fault_segment" ref_value="6"/>
        <bind_style_if_eq name="afc_path_failed" subject="afc_fault_segment" ref_value="6"/>
      </lv_obj>
    </lv_obj>

    <!-- Checkpoint names. Path vocabulary, not product names, so all four translate. -->
    <lv_obj width="100%" height="content" flex_flow="row" style_pad_all="0" style_pad_gap="0"
            style_bg_opa="0" style_border_width="0" scrollable="false">
      <text_small name="afc_stop_label_spool" text="Spool" translation_tag="Spool"
                  flex_grow="1" style_text_align="left"/>
      <text_small name="afc_stop_label_lane" text="Lane" translation_tag="Lane"
                  flex_grow="1" style_text_align="center"/>
      <text_small name="afc_stop_label_hub" text="Hub" translation_tag="Hub"
                  flex_grow="1" style_text_align="center"/>
      <text_small name="afc_stop_label_toolhead" text="Toolhead" translation_tag="Toolhead"
                  flex_grow="1" style_text_align="right"/>
    </lv_obj>
  </view>
</component>
