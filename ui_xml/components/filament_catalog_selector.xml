<!-- Embeddable branded-filament selector fragment: Vendor -> Type dropdowns
     driving a product list. No dialog/overlay chrome — hosts embed this and
     drive it via a FilamentCatalogSelector controller (attach/populate). -->
<component>
  <view name="filament_catalog_selector"
        extends="lv_obj" width="100%" height="content" style_pad_all="0"
        flex_flow="column" style_pad_gap="#space_md" scrollable="false">
    <!-- Vendor row -->
    <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row"
            style_flex_cross_place="center" style_pad_gap="#space_md" scrollable="false">
      <text_small text="Vendor" translation_tag="Vendor" width="60"/>
      <lv_dropdown name="vendor_dropdown" flex_grow="1" height="content"
                   style_radius="#border_radius">
        <event_cb trigger="value_changed" callback="catalog_select_vendor_changed_cb"/>
      </lv_dropdown>
    </lv_obj>
    <!-- Type row -->
    <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row"
            style_flex_cross_place="center" style_pad_gap="#space_md" scrollable="false">
      <text_small text="Type" translation_tag="Type" width="60"/>
      <lv_dropdown name="type_dropdown" flex_grow="1" height="content"
                   style_radius="#border_radius">
        <event_cb trigger="value_changed" callback="catalog_select_type_changed_cb"/>
      </lv_dropdown>
    </lv_obj>
    <!-- Product list (rows built in C++ by the controller). Elevated surface
         so the tappable pick-area reads as interactive against the panel bg. -->
    <lv_obj name="product_list" width="100%" height="content"
            style_bg_color="#elevated_bg" style_bg_opa="255" style_border_width="0"
            style_radius="#border_radius" style_pad_all="#space_xs"
            flex_flow="column" style_pad_gap="#space_xxs"/>
  </view>
</component>
